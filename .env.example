# Network Troubleshooting Assistant Configuration
# App Settings
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_HOST=localhost
APP_PORT=8501

# Diagnostics Policy
MAX_DIAGNOSTIC_TIMEOUT_SECONDS=15
PING_COUNT=3
PING_TIMEOUT_SECONDS=2
DNS_TIMEOUT_SECONDS=3
TCP_TIMEOUT_SECONDS=3
HTTP_TIMEOUT_SECONDS=5

# Security Target Policy
ALLOW_PRIVATE_IPS_IN_LOCAL_TESTS=true
BLOCKED_HOSTNAMES=169.254.169.254,metadata.google.internal

# Storage
DB_PATH=data/nta.db

# LLM Explanation & Natural Language Intake Layer
# options: none, ollama, lm_studio, openai, gemini
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Continuous Monitoring & Multi-Channel Alerting
MONITORING_INTERVAL_DEFAULT_SECONDS=60
ALERT_EMAIL=
ALERT_SLACK_WEBHOOK=
ALERT_GENERIC_WEBHOOK=

# SMTP Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@network-assistant.local

# Incident Ticketing (Jira / Webhooks)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=IT
TICKETING_WEBHOOK_URL=
